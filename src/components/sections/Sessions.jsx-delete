import { useState, useEffect } from 'react';
import { useInView } from '../../hooks/useInView';
import { getSessions } from '../../services/sessionService';
import { logFunnelEvent } from '../../services/funnelService';
import { useLanguage } from '../../context/LanguageContext';
import SpeakerBanner from '../SpeakerBanner.jsx-delete';

export default function Sessions() {
  const [ref, inView] = useInView(0.1);
  const [sessions, setSessions] = useState([]);
  const [loading, setLoading] = useState(true);
  const { t } = useLanguage();

  useEffect(() => {
    getSessions()
      .then(setSessions)
      .catch((err) => console.error('Failed to load sessions:', err))
      .finally(() => setLoading(false));
  }, []);

  function handleRegisterClick(sessionId) {
    logFunnelEvent('session_card_click', sessionId);
    document.getElementById('register')?.scrollIntoView({ behavior: 'smooth' });
  }

  return (
    <section id="sessions" ref={ref} className="w-full bg-neutral-50 px-6 py-20 md:px-16 md:py-28 lg:px-24">
   <p className="text-xs font-bold uppercase tracking-wide text-brand-red">{t('sessions.eyebrow')}</p>
<h2 className="mt-3 text-3xl font-bold tracking-[-0.02em] text-brand-ink md:text-4xl">
  {t('sessions.title')}
</h2>
<p className="mt-2 text-brand-muted">{t('sessions.subtitle')}</p>

      {loading && <p className="mt-10 text-sm text-brand-muted">Loading sessions...</p>}
      {!loading && sessions.length === 0 && (
        <p className="mt-10 text-sm text-red-600">No sessions found — check the backend is running.</p>
      )}

      {/* Was a 3-column card grid — now a single stacked column of full-width
          banners, since each one now carries much more information
          (speaker, duration, format, seating urgency) than the old
          compact card had room for. */}
      <div className="mt-10 space-y-5">
        {sessions.map((s) => (
          <SpeakerBanner key={s.id} session={s} onRegister={handleRegisterClick} />
        ))}
      </div>
    </section>
  );
}