
import { motion, AnimatePresence } from 'motion/react';
import { springs } from '../styles/motion';

export default function BookingDetail({ booking, onClose }) {
  return (
    <AnimatePresence>
      {booking && (
        <>
          <motion.div
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            exit={{ opacity: 0 }}
            onClick={onClose}
            className="fixed inset-0 z-40 bg-black/30"
          />
          <motion.div
            initial={{ x: '100%' }}
            animate={{ x: 0 }}
            exit={{ x: '100%' }}
            transition={springs.snappy}
            className="fixed right-0 top-0 z-50 h-full w-full max-w-sm overflow-y-auto border-l border-neutral-200 bg-white p-6"
          >
            <div className="flex items-center justify-between">
              <h3 className="text-lg font-bold text-brand-ink">Booking detail</h3>
              <button onClick={onClose} className="text-xl text-brand-muted hover:text-brand-ink">✕</button>
            </div>

            <div className="mt-6 space-y-4">
              <Row label="Name" value={`${booking.first_name} ${booking.last_name}`} />
              <Row label="Email" value={booking.email} />
              <Row label="Mobile" value={`+965 ${booking.phone}`} />
              <Row label="Session" value={booking.session_title || '—'} />
              <Row label="Format" value={booking.format === 'online' ? '💻 Online' : '📍 Offline'} />
              <Row label="Booked" value={new Date(booking.created_at).toLocaleString()} />
            </div>
          </motion.div>
        </>
      )}
    </AnimatePresence>
  );
}

function Row({ label, value }) {
  return (
    <div className="border-b border-neutral-100 pb-3">
      <p className="text-[11px] font-semibold uppercase tracking-wide text-brand-muted">{label}</p>
      <p className="mt-0.5 text-sm font-medium text-brand-ink">{value}</p>
    </div>
  );
}